[
  {
    "id": "cisms-patx-001",
    "exam": "CIS-SM",
    "release": "Zurich",
    "domain": "Service Mapping Pattern Design",
    "difficulty": "recall",
    "type": "single_select",
    "stem": "In a Service Mapping pattern, what does an identification section do?",
    "options": [
      {
        "id": "A",
        "text": "Identifies the current CI and its attributes"
      },
      {
        "id": "B",
        "text": "Finds the CIs the current one connects to"
      },
      {
        "id": "C",
        "text": "Stores the MID Server credentials"
      },
      {
        "id": "D",
        "text": "Schedules the discovery job"
      }
    ],
    "correct": [
      "A"
    ],
    "distractor_notes": {
      "B": "Finding connected CIs is the job of a connection section.",
      "C": "Credentials are configured separately, not in identification sections.",
      "D": "Scheduling is a discovery schedule setting, not a pattern section."
    },
    "rationale": "An identification section discovers and identifies the current CI and populates its attributes during pattern execution.",
    "references": [
      {
        "title": "Pattern identification sections",
        "url": "https://www.servicenow.com/docs/r/australia/it-operations-management/service-mapping/pattern-identification-sections.html"
      }
    ]
  },
