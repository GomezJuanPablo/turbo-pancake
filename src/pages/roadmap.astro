---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

// Public roadmap. CSA and CAD are live; CIS exams come next. Dates are
// intentionally rough — better honest than pretend-precise. Update by
// editing this file.
const phases = [
  {
    label: 'Now',
    color: 'live',
    items: [
      { exam: 'CSA',      title: 'Certified System Administrator',      detail: '240 questions across all 6 blueprint domains. Live.' },
      { exam: 'CAD',      title: 'Certified Application Developer',      detail: '240 questions across App Engine, Script Includes, GlideRecord, Service Portal, and integrations. Live.' },
      { exam: 'CIS-ITSM', title: 'CIS - IT Service Management',         detail: '240 questions across Incident, Problem, Change, Service Catalog, Service Portfolio, and CMDB. Live.' },
      { exam: 'CIS-DF',   title: 'CIS - Data Foundations',              detail: '240 questions covering CMDB design, data quality, import sets, transform maps, and integrations. Live.' },
      { exam: 'CIS-SM',   title: 'CIS - Service Mapping',               detail: 'Service discovery, dependency mapping, and service maps. Live.' },
    ],
  },
  {
    label: 'Next up',
    color: 'next',
    items: [
      { exam: 'CIS-RC', title: 'CIS - Risk and Compliance', detail: 'Policy management, risk assessment, and audit management.' },
    ],
  },
  {
    label: 'Coming soon',
    color: 'later',
    items: [
      { exam: 'CIS-HAM', title: 'CIS - Hardware Asset Management',   detail: 'Hardware asset lifecycle - procurement, discovery, normalization, and retirement.' },
    ],
  },
];

const principles = [
  { t: 'Doc-anchored only', d: 'Every question links to a live page on docs.servicenow.com. If the doc page disappears or moves, the question gets pulled, no exceptions, no guessing.' },
  { t: 'Voice rules are sacred', d: 'Stems plain and exam-accurate. Personality in rationales. 🧌 in achievements only.' },
  { t: 'No login, no PII, no ads', d: 'Anonymous progress via localStorage. Cloudflare Web Analytics for cookieless traffic counts.' },
];
---
<BaseLayout
  title="Roadmap — GlideUp.net"
  description="What's live, what's next. A 90-day view of where GlideUp is heading."
  activeNav="roadmap"
>
  <Breadcrumb crumbs={[
    { label: 'Practice', href: '/' },
    { label: 'Roadmap' },
  ]} />

  <h1 style="font-size:22px;font-weight:700;margin-bottom:8px;">Roadmap</h1>
  <p style="font-size:13px;color:var(--text-muted);margin-bottom:24px;max-width:720px;line-height:1.5;">
    Honest dates over pretend-precise ones. Each phase is one exam, ~240 questions,
    blueprint-weighted. If a date slips, this page updates first.
  </p>

  <div class="roadmap">
    {phases.map((p) => (
      <section class={`roadmap__phase phase--${p.color}`}>
        <header class="roadmap__phase-head">
          <span class="roadmap__phase-label">{p.label}</span>
        </header>
        {p.color === 'live' ? (
          <div class="live-list">
            {p.items.map((item) => (
              <div class="live-row">
                <span class="live-row__code">{item.exam}</span>
                <span class="live-row__title">{item.title}</span>
                <span class="live-badge">Live</span>
              </div>
            ))}
          </div>
        ) : (
          p.items.map((item) => (
            <article class="card roadmap__item">
              <div class="roadmap__item-code">{item.exam}</div>
              <div class="roadmap__item-title">{item.title}</div>
              <div class="roadmap__item-detail">{item.detail}</div>
            </article>
          ))
        )}
      </section>
    ))}
  </div>


  <h2 style="font-size:16px;font-weight:600;margin:32px 0 8px;">What we're building</h2>
  <p style="font-size:13px;color:var(--text-muted);margin-bottom:16px;max-width:640px;">
    Every domain in every exam is expanding to 120 questions minimum, so domain focus practice and exam simulations have real depth.
    Each bar shows current questions toward the 120Q-per-domain target.
  </p>
  <div class="build-grid">
      <div class="build-row">
        <div class="build-row__label">
          <span class="build-row__code">CSA</span>
          <span class="build-row__name">Certified System Administrator</span>
        </div>
        <div class="build-row__bar">
          <div class="build-row__fill" style="width:73%"></div>
        </div>
        <span class="build-row__count">526 / 720</span>
      </div>
      <div class="build-row">
        <div class="build-row__label">
          <span class="build-row__code">CAD</span>
          <span class="build-row__name">Certified Application Developer</span>
        </div>
        <div class="build-row__bar">
          <div class="build-row__fill" style="width:33%"></div>
        </div>
        <span class="build-row__count">240 / 720</span>
      </div>
      <div class="build-row">
        <div class="build-row__label">
          <span class="build-row__code">CIS-ITSM</span>
          <span class="build-row__name">CIS - IT Service Management</span>
        </div>
        <div class="build-row__bar">
          <div class="build-row__fill" style="width:33%"></div>
        </div>
        <span class="build-row__count">240 / 720</span>
      </div>
      <div class="build-row">
        <div class="build-row__label">
          <span class="build-row__code">CIS-DF</span>
          <span class="build-row__name">CIS - Data Foundations</span>
        </div>
        <div class="build-row__bar">
          <div class="build-row__fill" style="width:40%"></div>
        </div>
        <span class="build-row__count">240 / 600</span>
      </div>
      <div class="build-row">
        <div class="build-row__label">
          <span class="build-row__code">CIS-SM</span>
          <span class="build-row__name">CIS - Service Mapping</span>
        </div>
        <div class="build-row__bar">
          <div class="build-row__fill" style="width:33%"></div>
        </div>
        <span class="build-row__count">240 / 720</span>
      </div>
  </div>

  <h2 style="font-size:16px;font-weight:600;margin:32px 0 12px;">Principles we don't trade off</h2>
  <div class="card-grid">
    {principles.map((p) => (
      <article class="card">
        <div style="font-size:14px;font-weight:600;margin-bottom:6px;">{p.t}</div>
        <p style="font-size:13px;color:var(--text-muted);line-height:1.5;margin:0;">{p.d}</p>
      </article>
    ))}
  </div>
</BaseLayout>

<style>
  .roadmap {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 16px;
  }
  .roadmap__phase-head { margin-bottom: 10px; }
  .roadmap__phase-label {
    font-size: 11px; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.08em; padding: 4px 10px; border-radius: 999px;
    border: 1px solid var(--border);
  }
  .phase--live .roadmap__phase-label { color: var(--primary-dark); background: var(--primary-bg); border-color: rgba(14,139,158,0.25); }
  .phase--next .roadmap__phase-label { color: var(--amber); background: rgba(255,140,66,0.10); border-color: rgba(255,140,66,0.30); }
  .phase--later .roadmap__phase-label { color: var(--text-muted); }
  .roadmap__item-code { font-size: 11px; font-weight: 700; letter-spacing: 0.08em; color: var(--primary-dark); margin-bottom: 4px; }
  .roadmap__item-title { font-size: 14px; font-weight: 600; margin-bottom: 6px; }
  .roadmap__item-detail { font-size: 12px; color: var(--text-muted); line-height: 1.5; }

  .build-grid { display: flex; flex-direction: column; gap: 12px; max-width: 780px; margin-bottom: 32px; }
  .build-row { display: grid; grid-template-columns: 240px 1fr 80px; align-items: center; gap: 12px; }
  .build-row__label { display: flex; flex-direction: column; }
  .build-row__code { font-size: 11px; font-weight: 700; letter-spacing: 0.08em; color: var(--primary-dark); }
  .build-row__name { font-size: 12px; color: var(--text-muted); }
  .build-row__bar { height: 8px; background: var(--border); border-radius: 4px; overflow: hidden; }
  .build-row__fill { height: 100%; background: var(--primary); border-radius: 4px; transition: width 0.4s; }
  .build-row__count { font-size: 12px; color: var(--text-muted); text-align: right; white-space: nowrap; }
  @media (max-width: 680px) { .build-row { grid-template-columns: 1fr 60px; } .build-row__label { grid-column: 1/-1; } }


  .live-list { display: flex; flex-direction: column; gap: 6px; }
  .live-row {
    display: flex; align-items: center; gap: 10px;
    padding: 8px 12px; background: var(--surface);
    border: 1px solid var(--border); border-radius: 8px;
  }
  .live-row__code { font-size: 11px; font-weight: 700; letter-spacing: 0.08em; color: var(--primary-dark); min-width: 70px; }
  .live-row__title { font-size: 13px; color: var(--text); flex: 1; }
  .live-badge { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--primary-dark); background: var(--primary-bg); border: 1px solid rgba(14,139,158,0.25); padding: 2px 8px; border-radius: 999px; }

</style>
