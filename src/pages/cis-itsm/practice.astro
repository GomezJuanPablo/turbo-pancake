---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ThemeHeadsUp from '../../components/ThemeHeadsUp.astro';
import { getCollection, getEntry } from 'astro:content';

const blueprint = await getEntry('blueprints', 'cis-itsm');
const allQuestions = await getCollection('questions');
const examQuestions = allQuestions
  .filter((e) => e.id.startsWith('cis-itsm/'))
  .flatMap((e) => e.data);

// Build a small blueprint weight map for the client-side selector
const weights: Record<string, number> = {};
for (const d of blueprint!.data.domains) weights[d.name] = d.weight;
---
<BaseLayout
  title="CIS-ITSM Practice — GlideUp.net"
  description="Practice CIS-ITSM questions with goblin-encouraging explanations and verified doc links."
  activeNav="cis-itsm"
>
  <Breadcrumb crumbs={[
    { label: 'Practice', href: '/' },
    { label: 'CIS-ITSM', href: '/cis-itsm/' },
    { label: 'Question' },
  ]} />

  <ThemeHeadsUp />

  <div id="practice-root" class="practice-root" data-exam="CIS-ITSM">
    <div class="practice-meta">
      <span class="practice-meta__item" data-position>Question <span data-answered>0</span> answered</span>
      <span class="practice-meta__item">Accuracy <strong data-accuracy>—</strong></span>
      <span class="practice-meta__item" data-mode-label></span>
      <span class="practice-meta__item" data-session-progress></span>
    </div>

    <a class="redo-link" data-redo-link href="?redo=1" hidden>↻ Redo questions you missed (<span data-redo-count>0</span>)</a>

    <article
      class="question"
      data-question-card
      hidden
    >
      <div class="question__meta">
        <span data-domain>—</span>
        <span>•</span>
        <span data-difficulty>—</span>
      </div>
      <h2 class="question__stem" data-stem></h2>
      <div class="options" role="radiogroup" aria-label="Answer options" data-options></div>
      <div class="feedback" hidden data-feedback>
        <div class="feedback__opener" data-feedback-opener></div>
        <p class="feedback__rationale" data-rationale></p>
        <div class="feedback__distractors" data-distractors></div>
        <div class="feedback__refs" data-refs></div>
      </div>
      <div style="margin-top:16px;display:flex;gap:8px;">
        <button type="button" class="btn btn--primary" data-submit hidden>Check answer</button>
        <button type="button" class="btn btn--primary" data-next hidden>Next question →</button>
      </div>
      <div class="q-rate" data-q-rate>
        <span class="q-rate__label">Was this question clear and correct?</span>
        <button type="button" class="q-rate__btn" data-q-up title="Looks good" aria-label="This question looks good">👍</button>
        <button type="button" class="q-rate__btn" data-q-down title="Report a problem with this question" aria-label="Report a problem with this question">👎</button>
        <span class="q-rate__thanks" data-q-thanks hidden>Thanks for the signal! 🧌</span>
      </div>
    </article>

    <div class="card" data-empty hidden>
      <h2 style="font-size:16px;font-weight:600;margin-bottom:8px;">Out of questions for now</h2>
      <p style="font-size:13px;color:var(--text-muted);">
        You've seen them all. Want to start a fresh pass? Clear your local progress on the
        <a href="/about/">about</a> page.
      </p>
    </div>

    <div class="card" data-session-complete hidden>
      <h2 style="font-size:16px;font-weight:600;margin-bottom:8px;">Session complete</h2>
      <p style="font-size:13px;color:var(--text-muted);margin-bottom:16px;" data-complete-summary></p>
      <div style="display:flex;gap:8px;flex-wrap:wrap;">
        <a href="./practice/" class="btn btn--primary">New session</a>
        <a class="btn btn--ghost" data-redo-complete href="?redo=1" hidden>↻ Redo missed</a>
        <a href="./" class="btn btn--ghost">Dashboard</a>
      </div>      <div id="lb-form" style="margin-top:14px;border-top:1px solid var(--border);padding-top:14px;">
        <p style="font-size:12px;color:var(--text-muted);margin-bottom:8px;">Submit this score to the leaderboard? It's anonymous — just pick a username.</p>
        <div style="display:flex;gap:8px;flex-wrap:wrap;">
          <input id="lb-username" type="text" maxlength="24" placeholder="Your username" class="lb-input" />
          <button type="button" class="btn btn--ghost" id="lb-submit">Submit score</button>
        </div>
        <p id="lb-status" style="font-size:12px;margin-top:6px;color:var(--text-muted);"></p>
      </div>
    </div>
  </div>
</BaseLayout>

<script
  type="application/json"
  id="glideup-bank"
  set:html={JSON.stringify({ questions: examQuestions, weights })}
/>

<script>
  import { load, recordAnswer } from '../../lib/progress.js';
  import { pickNext, buildExamSet } from '../../lib/selection.js';
  import { isCorrect } from '../../lib/scoring.js';

  const bankEl = document.getElementById('glideup-bank');
  const { questions: bank, weights } = JSON.parse(bankEl.textContent || '{"questions":[],"weights":{}}');
  const bankIds = new Set(bank.map((q) => q.id));

  // --- Mode detection ---
  const params   = new URLSearchParams(window.location.search);
  const DOMAIN   = params.get('domain');          // domain focus
  const SET_NUM  = params.get('set') ? parseInt(params.get('set')) : null; // exam sim 1-4
  const IS_SIM   = SET_NUM !== null && SET_NUM >= 1 && SET_NUM <= 4;
  const REDO     = params.get('redo') === '1'; // re-do questions answered wrong

  // Questions answered but not yet gotten right, limited to this exam's bank.
  const _savedByQ  = (load().byQuestion) || {};
  const _missedSet = new Set(Object.keys(_savedByQ).filter(
    (id) => bankIds.has(id) && _savedByQ[id] && _savedByQ[id].correct === false));

  const SESSION_LIMIT = (IS_SIM || DOMAIN) ? 60 : Infinity;

  // Bounded modes (exam sim, domain focus, redo-missed) run a fixed, sequential
  // set with no repeats. Open-ended Full Practice keeps the adaptive selector.
  const IS_SESSION = SESSION_LIMIT < Infinity || REDO;

  function shuffle(arr) {
    const a = [...arr];
    for (let i = a.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [a[i], a[j]] = [a[j], a[i]];
    }
    return a;
  }

  const activeBank = IS_SIM
    ? buildExamSet(bank, weights, SET_NUM)
    : DOMAIN
      ? bank.filter(q => q.domain === DOMAIN)
      : REDO
        ? bank.filter(q => _missedSet.has(q.id))
        : bank;

  // For bounded sessions, present each question exactly once (deduped by id).
  // buildExamSet already returns a shuffled, unique 60; domain focus we shuffle here.
  const sessionQueue = IS_SESSION
    ? (() => {
        const seen = new Set();
        const unique = [];
        for (const q of (IS_SIM ? activeBank : shuffle(activeBank))) {
          if (seen.has(q.id)) continue;
          seen.add(q.id);
          unique.push(q);
        }
        return unique.slice(0, SESSION_LIMIT);
      })()
    : null;
  const SESSION_TOTAL = IS_SESSION ? sessionQueue.length : SESSION_LIMIT;
  let sessionIndex = 0;

  // --- DOM refs ---
  const root        = document.getElementById('practice-root');
  const card        = root.querySelector('[data-question-card]');
  const emptyEl     = root.querySelector('[data-empty]');
  const completeEl  = root.querySelector('[data-session-complete]');
  const stemEl      = root.querySelector('[data-stem]');
  const domainEl    = root.querySelector('[data-domain]');
  const diffEl      = root.querySelector('[data-difficulty]');
  const optionsEl   = root.querySelector('[data-options]');
  const feedbackEl  = root.querySelector('[data-feedback]');
  const openerEl    = root.querySelector('[data-feedback-opener]');
  const rationaleEl = root.querySelector('[data-rationale]');
  const distractorsEl = root.querySelector('[data-distractors]');
  const refsEl      = root.querySelector('[data-refs]');
  const submitBtn   = root.querySelector('[data-submit]');
  const nextBtn     = root.querySelector('[data-next]');
  const answeredEl  = root.querySelector('[data-answered]');
  const accuracyEl  = root.querySelector('[data-accuracy]');
  const modeLabelEl = root.querySelector('[data-mode-label]');
  const progressEl  = root.querySelector('[data-session-progress]');

  // Set mode label
  if (modeLabelEl) {
    if (REDO)     modeLabelEl.textContent = 'Redo: questions you missed';
    else if (IS_SIM)   modeLabelEl.textContent = `Exam Sim ${SET_NUM} of 4`;
    else if (DOMAIN) modeLabelEl.textContent = `Domain: ${DOMAIN}`;
    else          modeLabelEl.textContent = 'Full Practice';
  }

  const OPENERS_CORRECT_LOW  = ['✅ Correct.', '✅ Locked in.', '✅ Solid.', '✅ Right on.'];
  const OPENERS_CORRECT_MID  = ['✅ Three in a row. Warming up.', '✅ The goblin is nodding. 🧌', '✅ On a roll.', '✅ Four straight. Keep going.'];
  const OPENERS_CORRECT_HIGH = ['✅ Five straight. 🧌 The goblin approves.', "✅ Can't stop, won't stop.", '✅ The goblin is doing a little dance. 🧌', "✅ You're locked in. Don't break the streak."];
  const OPENERS_CORRECT_FIRE = ['✅ 🧌🔥 Ten straight. The goblin is losing its mind.', '✅ Unstoppable. The goblin bows.', '✅ 🧌 This is the way.', '✅ Double digits. The goblin demands a victory lap.'];
  const OPENERS_INCORRECT = ["⚠️ Not this one — but that's why we practice.", '⚠️ The goblin felt that. Read the rationale.', '⚠️ Close — check the explanation below.', '⚠️ Not quite. The goblin believes in you anyway. 🧌'];
  const pick = (xs) => xs[Math.floor(Math.random() * xs.length)];
  function streakOpener(streak) {
    if (streak >= 10) return pick(OPENERS_CORRECT_FIRE);
    if (streak >= 5)  return pick(OPENERS_CORRECT_HIGH);
    if (streak >= 3)  return pick(OPENERS_CORRECT_MID);
    return pick(OPENERS_CORRECT_LOW);
  }

  let selected  = null;
  let revealed  = false;
  let current   = null;
  let confirming = false;
  const SUBMIT_LABEL = 'Check answer';
  let sessionAnswered = 0;
  let sessionCorrect  = 0;

  function updateStats() {
    // Bounded sessions: header reflects THIS session and is driven by in-memory
    // counters, so it updates reliably even when localStorage is unavailable.
    if (IS_SESSION) {
      answeredEl.textContent = String(sessionAnswered);
      accuracyEl.textContent = sessionAnswered > 0
        ? Math.round((sessionCorrect / sessionAnswered) * 100) + '%'
        : '—';
      if (progressEl) progressEl.textContent = `${sessionAnswered} / ${SESSION_TOTAL}`;
      return;
    }
    // Full Practice: lifetime stats from saved progress.
    const state = load();
    const byQ   = state.byQuestion || {};
    const ids   = Object.keys(byQ);
    const total   = ids.length;
    const correct = ids.filter((id) => byQ[id].correct).length;
    answeredEl.textContent = String(total);
    accuracyEl.textContent = total > 0 ? Math.round((correct / total) * 100) + '%' : '—';
  }

  function showComplete() {
    card.hidden = true;
    emptyEl.hidden = true;
    if (completeEl) {
      completeEl.hidden = false;
      const pct = sessionAnswered > 0 ? Math.round((sessionCorrect / sessionAnswered) * 100) : 0;
      const summaryEl = completeEl.querySelector('[data-complete-summary]');
      if (summaryEl) {
        const label = IS_SIM ? `Exam Sim ${SET_NUM}` : DOMAIN ? `${DOMAIN} focus` : REDO ? 'Redo missed' : 'Session';
        summaryEl.textContent = `${label}: ${sessionCorrect} / ${sessionAnswered} correct (${pct}%)`;
      }
      const rc = completeEl.querySelector('[data-redo-complete]');
      if (rc) {
        const sb = (load().byQuestion) || {};
        const n = Object.keys(sb).filter((id) => bankIds.has(id) && sb[id] && sb[id].correct === false).length;
        rc.hidden = n === 0;
      }
    }
  }

  function renderQuestion(q) {
    current  = q;
    root.dataset.currentQid = q.id;
    const _qt = root.querySelector('[data-q-thanks]'); if (_qt) _qt.hidden = true;
    selected = null;
    revealed = false;

    card.hidden  = false;
    emptyEl.hidden = true;
    if (completeEl) completeEl.hidden = true;
    feedbackEl.hidden = true;
    feedbackEl.classList.remove('is-correct', 'is-incorrect');
    submitBtn.hidden = true;
    submitBtn.textContent = SUBMIT_LABEL;
    submitBtn.classList.remove('is-confirming');
    confirming = false;
    nextBtn.hidden   = true;

    stemEl.textContent   = q.stem;
    domainEl.textContent = q.domain;
    diffEl.textContent   = q.difficulty;

    optionsEl.innerHTML = '';
    for (const opt of q.options) {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'option';
      btn.dataset.option = opt.id;
      btn.setAttribute('role', 'radio');
      btn.setAttribute('aria-checked', 'false');
      btn.innerHTML = `<span class="option__letter">${opt.id}</span><span class="option__text"></span>`;
      btn.querySelector('.option__text').textContent = opt.text;
      btn.addEventListener('click', () => {
        if (revealed) return;
        for (const b of optionsEl.querySelectorAll('.option')) {
          b.setAttribute('aria-checked', 'false');
          b.classList.remove('is-selected');
        }
        btn.setAttribute('aria-checked', 'true');
        btn.classList.add('is-selected');
        selected = opt.id;
        // Changing the selection cancels a pending confirmation (fat-finger guard).
        confirming = false;
        submitBtn.textContent = SUBMIT_LABEL;
        submitBtn.classList.remove('is-confirming');
        submitBtn.hidden = false;
      });
      optionsEl.appendChild(btn);
    }

    rationaleEl.textContent = q.rationale;
    distractorsEl.innerHTML = '';
    for (const [letter, note] of Object.entries(q.distractor_notes || {})) {
      const row = document.createElement('div');
      row.className = 'feedback__distractor';
      const strong = document.createElement('strong');
      strong.textContent = letter + '.';
      row.appendChild(strong);
      row.appendChild(document.createTextNode(' ' + note));
      distractorsEl.appendChild(row);
    }
    refsEl.innerHTML = '<strong>References:</strong> ';
    for (const r of (q.references || [])) {
      const a = document.createElement('a');
      a.href = r.url; a.target = '_blank'; a.rel = 'noopener noreferrer';
      a.textContent = r.title + ' ↗';
      refsEl.appendChild(a);
      refsEl.appendChild(document.createTextNode(' '));
    }
  }

  function advance() {
    // Bounded sessions walk a fixed, unique queue in order — no repeats.
    if (IS_SESSION) {
      if (sessionIndex >= sessionQueue.length) { showComplete(); return; }
      renderQuestion(sessionQueue[sessionIndex++]);
      return;
    }
    // Full Practice: adaptive, history-weighted selection.
    const next = pickNext(activeBank, weights, root.dataset.exam);
    if (!next) { card.hidden = true; emptyEl.hidden = false; return; }
    renderQuestion(next);
  }

  submitBtn?.addEventListener('click', () => {
    if (!selected || !current || revealed) return;
    // First click arms confirmation; second click locks the answer in.
    if (!confirming) {
      confirming = true;
      submitBtn.textContent = 'Confirm answer ✓';
      submitBtn.classList.add('is-confirming');
      return;
    }
    confirming = false;
    submitBtn.classList.remove('is-confirming');
    revealed = true;
    const correct = isCorrect([selected], current.correct);

    for (const b of optionsEl.querySelectorAll('.option')) {
      const letter = b.dataset.option;
      if (current.correct.includes(letter)) b.classList.add('is-correct');
      else if (letter === selected)          b.classList.add('is-incorrect');
      b.disabled = true;
    }

    feedbackEl.hidden = false;
    feedbackEl.classList.add(correct ? 'is-correct' : 'is-incorrect');
    openerEl.textContent = correct ? streakOpener(sessionCorrect) : pick(OPENERS_INCORRECT);
    if (correct && (sessionCorrect % 3 === 0 || sessionCorrect >= 5)) {
      const goblinEl = root.querySelector('[data-goblin-pop]');
      if (goblinEl) {
        goblinEl.classList.add('is-visible');
        setTimeout(() => goblinEl.classList.remove('is-visible'), 1800);
      }
    }

    recordAnswer({ questionId: current.id, exam: current.exam, domain: current.domain, correct });
    sessionAnswered++;
    if (correct) sessionCorrect++;
    updateStats();
    submitBtn.hidden = true;
    nextBtn.hidden   = false;
  });

  nextBtn?.addEventListener('click', advance);

  // Redo-missed entry points
  const _missedHere = [..._missedSet].length;
  const _redoLink  = root.querySelector('[data-redo-link]');
  const _redoCount = root.querySelector('[data-redo-count]');
  if (_redoCount) _redoCount.textContent = String(_missedHere);
  if (_redoLink && _missedHere > 0 && !REDO && !IS_SESSION) _redoLink.hidden = false;
  if (REDO) { const _lbf = root.querySelector('#lb-form'); if (_lbf) _lbf.hidden = true; }

  updateStats();
  advance();

  // Leaderboard submission
  const lbSubmitBtn = root.querySelector('#lb-submit');
  const lbUsernameEl = root.querySelector('#lb-username') as HTMLInputElement | null;
  const lbStatus = root.querySelector('#lb-status');

  lbSubmitBtn?.addEventListener('click', async () => {
    const username = lbUsernameEl?.value.trim();
    if (!username) { if (lbStatus) lbStatus.textContent = 'Enter a username first.'; return; }
    if (lbStatus) lbStatus.textContent = 'Submitting…';
    lbSubmitBtn.disabled = true;
    try {
      const res = await fetch('/api/scores', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          username,
          exam: root.dataset.exam,
          mode: IS_SIM ? `Exam Sim ${SET_NUM}` : DOMAIN ? `Focus: ${DOMAIN}` : 'Full Practice',
          score: sessionCorrect,
          total: sessionAnswered,
        }),
      });
      const data = await res.json();
      if (data.ok) {
        if (lbStatus) lbStatus.textContent = `Submitted! You ranked #${data.rank} for this exam.`;
        const lbForm = root.querySelector('#lb-form');
        if (lbForm) (lbForm as HTMLElement).style.opacity = '0.5';
        lbSubmitBtn.disabled = true;
      } else {
        if (lbStatus) lbStatus.textContent = data.error || 'Could not submit.';
        lbSubmitBtn.disabled = false;
      }
    } catch {
      if (lbStatus) lbStatus.textContent = 'Network error — try again.';
      lbSubmitBtn.disabled = false;
    }
  });

  // Per-question feedback (thumbs up / down)
  const rateUp = root.querySelector('[data-q-up]');
  const rateDown = root.querySelector('[data-q-down]');
  const rateThanks = root.querySelector('[data-q-thanks]');
  rateUp?.addEventListener('click', () => {
    if (rateThanks) { rateThanks.hidden = false; setTimeout(() => { rateThanks.hidden = true; }, 1600); }
  });
  rateDown?.addEventListener('click', () => {
    if ((window as any).glideupOpenFeedback) (window as any).glideupOpenFeedback('question');
  });
</script>

<style>
  .practice-root { max-width: 820px; }
  .practice-meta {
    display: flex;
    gap: 16px;
    font-size: 12px;
    color: var(--text-muted);
    margin-bottom: 12px;
  }
  .practice-meta strong { color: var(--primary-dark); font-weight: 700; }

  .goblin-pop {
    position: fixed; bottom: 32px; right: 32px; font-size: 52px;
    opacity: 0; transform: scale(0.4) translateY(20px);
    transition: opacity 0.25s, transform 0.25s;
    pointer-events: none; z-index: 500; filter: drop-shadow(0 4px 12px rgba(0,0,0,0.25));
  }
  .goblin-pop.is-visible { opacity: 1; transform: scale(1) translateY(0); }


  .lb-input {
    font-size: 13px; padding: 6px 10px; border: 1px solid var(--border);
    border-radius: 6px; background: var(--bg); color: var(--text);
    outline: none; width: 160px;
  }
  .lb-input:focus { border-color: var(--primary); }

</style>
