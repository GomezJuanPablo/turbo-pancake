---
interface Props {
  title: string;
  weight: string;
  answered: number;
  total: number;
  accuracy?: number;
  tier?: 'new' | 'bronze' | 'silver' | 'gold';
  href?: string;
}
const { title, weight, answered, total, accuracy = 0, tier = 'new', href } = Astro.props;

const pct = total > 0 ? Math.round((answered / total) * 100) : 0;
const tierLabel = {
  new:    'Start',
  bronze: '🥉 Bronze',
  silver: '🥈 Silver',
  gold:   '🏆 Gold',
}[tier] ?? 'Start';

const Tag = href ? 'a' : 'article';
---
<Tag class={`card domain-card ${href ? 'domain-card--link' : ''}`} href={href}>
  <div class="domain-card__head">
    <div>
      <div class="domain-card__title">{title}</div>
      <div class="domain-card__weight">{weight} of exam</div>
    </div>
    <span class={`tier is-${tier}`}>{tierLabel}</span>
  </div>
  <div class="domain-card__progress" role="progressbar"
       aria-valuenow={pct} aria-valuemin="0" aria-valuemax="100">
    <div class="domain-card__progress-fill" style={`width:${pct}%`}></div>
  </div>
  <div class="domain-card__meta">
    <span>{answered} / {total} answered</span>
    {answered > 0 && <span>{accuracy}% accuracy</span>}
    {answered === 0 && href && <span style="color:var(--primary);font-size:11px;font-weight:600;">Practice this domain →</span>}
  </div>
</Tag>

<style>
  .domain-card--link {
    display: block;
    text-decoration: none;
    color: inherit;
    cursor: pointer;
    transition: border-color var(--t-fast, 0.15s), transform var(--t-fast, 0.15s);
  }
  .domain-card--link:hover {
    border-color: var(--primary);
    transform: translateY(-1px);
  }
</style>
