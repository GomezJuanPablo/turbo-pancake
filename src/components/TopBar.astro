---
interface Props {
  activeNav?: string;
}
const { activeNav = '' } = Astro.props;

const navItems = [
  { id: 'all',    label: 'All',    href: '/' },
  { id: 'github', label: 'GitHub', href: 'https://github.com/GomezJuanPablo/turbo-pancake', external: true },
  { id: 'docs',   label: 'ServiceNow Docs', href: 'https://www.servicenow.com/docs/', external: true },
];

const activeLabel = navItems.find(i => i.id === activeNav)?.label ?? 'All';
---
<header class="topbar">
  <a href="/" class="topbar__brand" aria-label="GlideUp home">
    <img src="/brand/logo-mark.png" alt="" width="24" height="24" decoding="async" class="topbar__brand-mark" />
    <span>GlideUp</span>
  </a>

  <!-- Desktop nav (hidden on mobile via CSS) -->
  <nav class="topbar__nav" aria-label="Top navigation">
    {navItems.map((item) => (
      <a href={item.href} class={`topbar__nav-item ${activeNav === item.id ? 'is-active' : ''}`} {...(item.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>{item.label}</a>
    ))}
  </nav>

  <!-- Mobile: current section + hamburger -->
  <button class="topbar__hamburger" id="nav-toggle" aria-label="Open navigation" aria-expanded="false">
    <span class="topbar__active-label">{activeLabel}</span>
    <svg width="16" height="12" viewBox="0 0 16 12" fill="none" aria-hidden="true">
      <rect width="16" height="2" rx="1" fill="currentColor"/>
      <rect y="5" width="16" height="2" rx="1" fill="currentColor"/>
      <rect y="10" width="16" height="2" rx="1" fill="currentColor"/>
    </svg>
  </button>

  <div class="topbar__status" aria-label="User status">
    <span class="status-pill" title="Streak (days)">🔥 <span data-streak>0</span></span>
    <span class="status-pill" title="Experience points">⚡ <span data-xp>0</span></span>
  </div>
</header>

<!-- Mobile dropdown (closed by default) -->
<nav class="topbar__dropdown" id="nav-menu" aria-label="Mobile navigation">
  {navItems.map((item) => (
    <a href={item.href} class={`topbar__dropdown-item ${activeNav === item.id ? 'is-active' : ''}`} {...(item.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>{item.label}</a>
  ))}
</nav>

<script>
  try {
    const raw = localStorage.getItem('glideup:progress:v1');
    if (raw) {
      const state = JSON.parse(raw);
      const xpEl = document.querySelector('[data-xp]');
      const streakEl = document.querySelector('[data-streak]');
      if (xpEl) xpEl.textContent = String(state.xp ?? 0);
      if (streakEl) streakEl.textContent = String(state?.streak?.count ?? 0);
    }
  } catch { /* swallow */ }

  const toggle = document.getElementById('nav-toggle');
  const menu   = document.getElementById('nav-menu');

  toggle?.addEventListener('click', (e) => {
    e.stopPropagation();
    const isOpen = menu?.classList.contains('is-open');
    menu?.classList.toggle('is-open', !isOpen);
    toggle.setAttribute('aria-expanded', String(!isOpen));
  });

  document.addEventListener('click', (e) => {
    if (!menu?.contains(e.target as Node) && !toggle?.contains(e.target as Node)) {
      menu?.classList.remove('is-open');
      toggle?.setAttribute('aria-expanded', 'false');
    }
  });
</script>

<style>
  /* Hamburger button — mobile only */
  .topbar__hamburger {
    display: none;
    align-items: center;
    gap: 8px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px 6px;
    color: rgba(255,255,255,0.85);
    font-size: 13px;
    font-weight: 600;
    border-radius: 6px;
    transition: background 0.15s;
  }
  .topbar__hamburger:hover { background: rgba(255,255,255,0.08); }
  .topbar__active-label { color: var(--primary); }

  /* Dropdown — hidden by default, shown when .is-open */
  .topbar__dropdown {
    display: none;
    flex-direction: column;
    position: fixed;
    top: 48px;
    left: 0;
    right: 0;
    z-index: 300;
    background: var(--chrome);
    border-bottom: 1px solid rgba(255,255,255,0.1);
    box-shadow: 0 8px 24px rgba(0,0,0,0.3);
  }
  .topbar__dropdown.is-open { display: flex; }

  .topbar__dropdown-item {
    padding: 12px 20px;
    font-size: 14px;
    font-weight: 500;
    color: rgba(255,255,255,0.75);
    text-decoration: none;
    border-bottom: 1px solid rgba(255,255,255,0.05);
    transition: background 0.1s, color 0.1s;
  }
  .topbar__dropdown-item:last-child { border-bottom: none; }
  .topbar__dropdown-item:hover { background: rgba(255,255,255,0.06); color: #fff; }
  .topbar__dropdown-item.is-active { color: var(--primary); }

  /* Swap desktop nav for hamburger on mobile */
  @media (max-width: 680px) {
    .topbar__nav { display: none; }
    .topbar__hamburger { display: flex; }
  }
</style>
