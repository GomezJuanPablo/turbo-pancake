---
interface Props {
  activeNav?: string;
}
const { activeNav = '' } = Astro.props;

const navItems = [
  { id: 'all',    label: 'All',    href: '/' },
  { id: 'github', label: 'GitHub', href: 'https://github.com/GomezJuanPablo/turbo-pancake', external: true },
  { id: 'docs',   label: 'ServiceNow Docs', href: 'https://www.servicenow.com/docs/', external: true },
];

const activeLabel = navItems.find(i => i.id === activeNav)?.label ?? 'All';
---
<header class="topbar">
  <a href="/" class="topbar__brand" aria-label="GlideUp home">
    <img src="/brand/logo-mark.png" alt="" width="24" height="24" decoding="async" class="topbar__brand-mark" />
    <span>GlideUp</span>
  </a>

  <!-- Desktop nav (hidden on mobile via CSS) -->
  <nav class="topbar__nav" aria-label="Top navigation">
    {navItems.map((item) => (
      <a href={item.href} class={`topbar__nav-item ${activeNav === item.id ? 'is-active' : ''}`} {...(item.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>{item.label}</a>
    ))}
  </nav>

  <!-- Mobile: current section + hamburger -->
  <button class="topbar__hamburger" id="nav-toggle" aria-label="Open navigation" aria-expanded="false">
    <span class="topbar__active-label">{activeLabel}</span>
    <svg width="16" height="12" viewBox="0 0 16 12" fill="none" aria-hidden="true">
      <rect width="16" height="2" rx="1" fill="currentColor"/>
      <rect y="5" width="16" height="2" rx="1" fill="currentColor"/>
      <rect y="10" width="16" height="2" rx="1" fill="currentColor"/>
    </svg>
  </button>

  <div class="topbar__status" aria-label="User status">
    <div class="topbar__settings" data-settings>
      <button type="button" class="topbar__gear" data-settings-toggle aria-haspopup="true" aria-expanded="false" aria-label="Settings and theme">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="3"></circle>
          <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
        </svg>
      </button>
      <div class="topbar__menu" data-settings-menu role="menu" aria-label="Theme">
        <div class="topbar__menu-title">Theme</div>
        <button type="button" class="theme-opt" data-theme-set="zurich"    role="menuitemradio"><span class="theme-opt__dot" style="background:#0E8B9E"></span><span class="theme-opt__name">Zurich</span><span class="theme-opt__check">✓</span></button>
        <button type="button" class="theme-opt" data-theme-set="tokyo"     role="menuitemradio"><span class="theme-opt__dot" style="background:#D6336C"></span><span class="theme-opt__name">Tokyo</span><span class="theme-opt__check">✓</span></button>
        <button type="button" class="theme-opt" data-theme-set="yokohama"  role="menuitemradio"><span class="theme-opt__dot" style="background:#1F77C2"></span><span class="theme-opt__name">Yokohama</span><span class="theme-opt__check">✓</span></button>
        <button type="button" class="theme-opt" data-theme-set="xanadu"    role="menuitemradio"><span class="theme-opt__dot" style="background:#7C5CD6"></span><span class="theme-opt__name">Xanadu</span><span class="theme-opt__check">✓</span></button>
        <button type="button" class="theme-opt" data-theme-set="vancouver" role="menuitemradio"><span class="theme-opt__dot" style="background:#15163A"></span><span class="theme-opt__name">Vancouver</span><span class="theme-opt__check">✓</span></button>
      </div>
    </div>
    <span class="status-pill" title="Streak (days)">🔥 <span data-streak>0</span></span>
    <span class="status-pill" title="Experience points">⚡ <span data-xp>0</span></span>
  </div>
</header>

<!-- Mobile dropdown (closed by default) -->
<nav class="topbar__dropdown" id="nav-menu" aria-label="Mobile navigation">
  {navItems.map((item) => (
    <a href={item.href} class={`topbar__dropdown-item ${activeNav === item.id ? 'is-active' : ''}`} {...(item.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>{item.label}</a>
  ))}
</nav>

<script>
  try {
    const raw = localStorage.getItem('glideup:progress:v1');
    if (raw) {
      const state = JSON.parse(raw);
      const xpEl = document.querySelector('[data-xp]');
      const streakEl = document.querySelector('[data-streak]');
      if (xpEl) xpEl.textContent = String(state.xp ?? 0);
      if (streakEl) streakEl.textContent = String(state?.streak?.count ?? 0);
    }
  } catch { /* swallow */ }

  const toggle = document.getElementById('nav-toggle');
  const menu   = document.getElementById('nav-menu');

  toggle?.addEventListener('click', (e) => {
    e.stopPropagation();
    const isOpen = menu?.classList.contains('is-open');
    menu?.classList.toggle('is-open', !isOpen);
    toggle.setAttribute('aria-expanded', String(!isOpen));
  });

  document.addEventListener('click', (e) => {
    if (!menu?.contains(e.target as Node) && !toggle?.contains(e.target as Node)) {
      menu?.classList.remove('is-open');
      toggle?.setAttribute('aria-expanded', 'false');
    }
  });

  // Theme switcher (gear menu)
  const settings = document.querySelector('[data-settings]');
  const gear = document.querySelector('[data-settings-toggle]');
  const themeMenu = document.querySelector('[data-settings-menu]');
  const opts = document.querySelectorAll('[data-theme-set]');
  const markActive = (t) => opts.forEach((b) => b.classList.toggle('is-active', b.getAttribute('data-theme-set') === t));
  markActive(document.documentElement.dataset.theme || 'zurich');
  const closeThemeMenu = () => { themeMenu?.classList.remove('is-open'); gear?.setAttribute('aria-expanded', 'false'); };
  gear?.addEventListener('click', (e) => {
    e.stopPropagation();
    const open = themeMenu?.classList.toggle('is-open');
    gear.setAttribute('aria-expanded', String(!!open));
  });
  opts.forEach((b) => b.addEventListener('click', () => {
    const t = b.getAttribute('data-theme-set');
    document.documentElement.dataset.theme = t;
    try { localStorage.setItem('glideup:theme', t); } catch (e) {}
    markActive(t);
    closeThemeMenu();
  }));
  document.addEventListener('click', (e) => { if (settings && !settings.contains(e.target as Node)) closeThemeMenu(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeThemeMenu(); });
</script>

<style>
  /* Hamburger button — mobile only */
  .topbar__hamburger {
    display: none;
    align-items: center;
    gap: 8px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px 6px;
    color: rgba(255,255,255,0.85);
    font-size: 13px;
    font-weight: 600;
    border-radius: 6px;
    transition: background 0.15s;
  }
  .topbar__hamburger:hover { background: rgba(255,255,255,0.08); }
  .topbar__active-label { color: var(--primary); }

  /* Dropdown — hidden by default, shown when .is-open */
  .topbar__dropdown {
    display: none;
    flex-direction: column;
    position: fixed;
    top: 48px;
    left: 0;
    right: 0;
    z-index: 300;
    background: var(--chrome);
    border-bottom: 1px solid rgba(255,255,255,0.1);
    box-shadow: 0 8px 24px rgba(0,0,0,0.3);
  }
  .topbar__dropdown.is-open { display: flex; }

  .topbar__dropdown-item {
    padding: 12px 20px;
    font-size: 14px;
    font-weight: 500;
    color: rgba(255,255,255,0.75);
    text-decoration: none;
    border-bottom: 1px solid rgba(255,255,255,0.05);
    transition: background 0.1s, color 0.1s;
  }
  .topbar__dropdown-item:last-child { border-bottom: none; }
  .topbar__dropdown-item:hover { background: rgba(255,255,255,0.06); color: #fff; }
  .topbar__dropdown-item.is-active { color: var(--primary); }

  /* Swap desktop nav for hamburger on mobile */
  @media (max-width: 680px) {
    .topbar__nav { display: none; }
    .topbar__hamburger { display: flex; }
  }
</style>
