---
import '../styles/global.css';
import TopBar from '../components/TopBar.astro';
import SideNav from '../components/SideNav.astro';
import FeedbackWidget from '../components/FeedbackWidget.astro';

interface Props {
  title?: string;
  description?: string;
  activeNav?: string;
}

const {
  title = 'GlideUp.net — Free ServiceNow Cert Practice',
  description = 'Free, community-built, doc-anchored ServiceNow certification practice. CSA, CAD, CIS-ITSM, CIS-DF. No login required.',
  activeNav = '',
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>try{var t=localStorage.getItem('glideup:theme');if(t)document.documentElement.dataset.theme=t;}catch(e){}</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" href="/brand/logo-mark.png" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://glideup.net" />
    <meta property="og:image" content="/og-image.png" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Preconnect for Inter -->
    <link rel="preconnect" href="https://rsms.me" />
    <link rel="stylesheet" href="https://rsms.me/inter/inter.css" />
    <!-- Google AdSense -->
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2897604935002362" crossorigin="anonymous"></script>
  </head>
  <body>
    <div class="app-shell">
      <TopBar activeNav={activeNav} />
      <SideNav activeNav={activeNav} />
      <main class="content">
        <div class="content__inner">
          <slot />
          <!-- Subtle, single ad slot. After approval, create ONE Display unit in AdSense
               and paste its slot id into data-ad-slot below, then uncomment the block. -->
          <aside class="ad-quiet" aria-label="Advertisement">
            <span class="ad-quiet__lbl">Advertisement</span>
            <!--
            <ins class="adsbygoogle" style="display:block"
                 data-ad-client="ca-pub-2897604935002362"
                 data-ad-slot="REPLACE_WITH_SLOT_ID"
                 data-ad-format="auto"
                 data-full-width-responsive="true"></ins>
            <script>(adsbygoogle = window.adsbygoogle || []).push({});</script>
            -->
          </aside>
        </div>
      </main>
    </div>

    <!-- Ko-fi floating support link.
         IMPORTANT: do NOT use Ko-fi's Widget_2.js + kofiwidget2.draw()
         embed on a static Astro page. That script uses document.write,
         which wipes the entire <body> when called after window.load —
         observed in production on 2026-05-17 (live site rendered as the
         Ko-fi button only). A plain styled link gets the same result
         without the destructive script. -->
    <a
      class="kofi-link"
      href="https://ko-fi.com/Y8Y21ZOMNW"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Support GlideUp on Ko-fi"
    >
      <img
        src="https://storage.ko-fi.com/cdn/cup-border.png"
        alt=""
        width="20"
        height="20"
      />
      <span>Support GlideUp on Ko-fi</span>
    </a>

    <FeedbackWidget />
  </body>
</html>

<style>
  /* Subtle ad slot — intentionally low-key and easy to ignore */
  .ad-quiet{
    max-width:728px;margin:48px auto 8px;padding-top:14px;
    border-top:1px solid color-mix(in srgb, currentColor 10%, transparent);
    text-align:center;opacity:.75;
  }
  .ad-quiet__lbl{
    display:block;font-size:.62rem;letter-spacing:.12em;text-transform:uppercase;
    opacity:.5;margin-bottom:6px;
  }
  .ad-quiet ins{margin:0 auto}
</style>
