---
import '../styles/global.css';
import TopBar from '../components/TopBar.astro';
import SideNav from '../components/SideNav.astro';
import FeedbackWidget from '../components/FeedbackWidget.astro';

interface Props {
  title?: string;
  description?: string;
  activeNav?: string;
}

const {
  title = 'GlideUp.net — Free ServiceNow Cert Practice',
  description = 'Free, community-built, doc-anchored ServiceNow certification practice. CSA, CAD, CIS-ITSM, CIS-DF. No login, no ads.',
  activeNav = '',
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" href="/brand/logo-mark.png" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://glideup.net" />
    <meta property="og:image" content="/og-image.png" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Preconnect for Inter -->
    <link rel="preconnect" href="https://rsms.me" />
    <link rel="stylesheet" href="https://rsms.me/inter/inter.css" />
  </head>
  <body>
    <div class="app-shell">
      <TopBar activeNav={activeNav} />
      <SideNav activeNav={activeNav} />
      <main class="content">
        <div class="content__inner">
          <slot />
        </div>
      </main>
    </div>

    <!-- Ko-fi floating support link.
         IMPORTANT: do NOT use Ko-fi's Widget_2.js + kofiwidget2.draw()
         embed on a static Astro page. That script uses document.write,
         which wipes the entire <body> when called after window.load —
         observed in production on 2026-05-17 (live site rendered as the
         Ko-fi button only). A plain styled link gets the same result
         without the destructive script. -->
    <a
      class="kofi-link"
      href="https://ko-fi.com/Y8Y21ZOMNW"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Support GlideUp on Ko-fi"
    >
      <img
        src="https://storage.ko-fi.com/cdn/cup-border.png"
        alt=""
        width="20"
        height="20"
      />
      <span>Support GlideUp on Ko-fi</span>
    </a>

    <FeedbackWidget />
  </body>
</html>
